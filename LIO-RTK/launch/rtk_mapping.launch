<?xml version="1.0"?>
<!--
  Single RTK-fusion entry point for both clean and degraded bags.

  The algorithm and YAML are identical in both cases.  The supplied bags use
  /rtk_truth/* as the fusion input in both the untouched and injected replay;
  /rtk/* remains the independent EVO reference stream.
-->
<launch>
  <arg name="rviz" default="false"/>
  <arg name="enable_rtk" default="true"/>
  <arg name="start_rtk_driver" default="false"/>
  <arg name="rtk_port" default="/dev/ttyUSB1"/>
  <arg name="rtk_baud" default="115200"/>
  <arg name="rtk_epoch_topic" default="/rtk/epoch"/>
  <arg name="rtk_heading_topic" default="/rtk/heading"/>
  <arg name="tum_file_path"
       default="/home/gsm/FAST-LIRO3/LIO_RTK_normal.txt"/>

  <include if="$(arg start_rtk_driver)"
           file="$(find nmea_rtk_driver)/launch/nmea_rtk_driver.launch">
    <arg name="port" value="$(arg rtk_port)"/>
    <arg name="baud" value="$(arg rtk_baud)"/>
  </include>

  <!-- The one formal YAML for clean and degraded replay. -->
  <rosparam command="load"
            file="$(find fast_lio_rtk)/config/lslidar_rtk.yaml"/>
  <param name="rtk/enabled" type="bool" value="$(arg enable_rtk)"/>
  <param name="rtk/epoch_topic" value="$(arg rtk_epoch_topic)"/>
  <param name="rtk/heading_topic" value="$(arg rtk_heading_topic)"/>
  <param name="trajectory_save/tum_file_path" value="$(arg tum_file_path)"/>

  <param name="feature_extract_enable" type="bool" value="false"/>
  <param name="point_filter_num" type="int" value="1"/>
  <param name="max_iteration" type="int" value="3"/>
  <param name="filter_size_surf" type="double" value="0.5"/>
  <param name="filter_size_map" type="double" value="0.5"/>
  <param name="cube_side_length" type="double" value="300"/>
  <param name="runtime_pos_log_enable" type="bool" value="false"/>

  <node pkg="fast_lio_rtk"
        type="fastlio_mapping"
        name="laserMapping_unified"
        output="screen"/>

  <group if="$(arg rviz)">
    <node launch-prefix="nice"
          pkg="rviz"
          type="rviz"
          name="rviz_unified"
          args="-d $(find fast_lio_rtk)/rviz_cfg/loam_livox.rviz"/>
  </group>
</launch>
